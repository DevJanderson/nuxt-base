{
  "name": "nuxt-base",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@11.27.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "nuxt typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "knip": "knip",
    "dup": "jscpd app server tests",
    "smoke": "node scripts/smoke.mjs",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm knip && pnpm dup && pnpm smoke"
  },
  "dependencies": {
    "@nuxt/fonts": "0.14.0",
    "@nuxt/icon": "2.5.1",
    "@nuxtjs/color-mode": "4.0.1",
    "@pinia/nuxt": "1.0.2",
    "@tailwindcss/vite": "4.3.3",
    "@vueuse/nuxt": "14.4.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "nuxt": "4.5.2",
    "pinia": "4.0.3",
    "reka-ui": "2.10.4",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.3",
    "vue": "3.5.43",
    "vue-router": "5.3.1"
  },
  "devDependencies": {
    "@iconify-json/lucide": "1.2.135",
    "@nuxt/eslint": "1.17.0",
    "@nuxt/test-utils": "4.3.2",
    "@vue/test-utils": "2.5.1",
    "eslint": "10.11.0",
    "eslint-plugin-sonarjs": "4.2.1",
    "happy-dom": "20.14.5",
    "jscpd": "5.3.0",
    "knip": "6.37.0",
    "lefthook": "2.1.14",
    "playwright-core": "1.63.0",
    "terser": "5.51.2",
    "typescript": "6.0.3",
    "vitest": "4.1.11",
    "vue-tsc": "3.3.11"
  }
}
